{
  "name": "@vfdm/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "zip": "cd dist && zip -qr ../vfdm-extension.zip . && cd .. && echo vfdm-extension.zip"
  },
  "dependencies": {
    "@vfdm/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
